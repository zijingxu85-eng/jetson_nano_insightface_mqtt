#!/usr/bin/env bash
# 提交前拦截：疑似密钥 / 硬编码凭证
# 安装：cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -u

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

bad=0
for f in $staged; do
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.bmp|*.onnx|*.engine|*.npz|*.zip|*.tar|*.gz) continue ;;
  esac
  [ -f "$f" ] || continue

  # 32 位以上十六进制串（巴法云私钥、各类 token 的常见形态）
  hits=$(grep -InE "[a-f0-9]{32,}" "$f" 2>/dev/null | grep -viE "example|sha256|sha1|md5|commit|integrity|uuid")
  if [ -n "$hits" ]; then
    echo "[pre-commit] ❌ $f 含疑似密钥（32+ 位十六进制）："
    echo "$hits" | head -3 | sed 's/^/      /'
    bad=1
  fi

  # 硬编码凭证
  cred=$(grep -InE "(api[_-]?key|secret|token|passwd|password|private[_-]?key)[[:space:]]*=[[:space:]]*[\"'][^\"']{8,}" "$f" 2>/dev/null)
  if [ -n "$cred" ]; then
    echo "[pre-commit] ❌ $f 含硬编码凭证："
    echo "$cred" | head -3 | sed 's/^/      /'
    bad=1
  fi
done

if [ "$bad" -eq 1 ]; then
  echo ""
  echo "提交已阻止。请把密钥移到 local_secrets.py（已在 .gitignore 中）或环境变量。"
  echo "确实需要绕过：git commit --no-verify"
  exit 1
fi
exit 0
